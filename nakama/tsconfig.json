{
  "compilerOptions": {
    "noImplicitReturns": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "removeComments": true,
    "target": "es5",
    "lib": [
      "es2015"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "strict": false,
    "typeRoots": [
      "./node_modules"
    ],
    "outDir": "build"
  },
  "files": [
    "./node_modules/nakama-runtime/index.d.ts"
  ],
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
